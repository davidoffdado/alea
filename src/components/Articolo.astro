---
// Un articolo in home: grande ("apertura") per l'ultimo, in griglia per gli altri. Si apre in una nuova scheda.
import Copertina from "./Copertina.astro";
import { url } from "../config.js";
const { articolo: a, apertura = false } = Astro.props;
const data = a.data ? new Date(a.data).toLocaleDateString("it-IT", { day: "numeric", month: "long", year: "numeric" }) : "—";
const numero = a.numero ? `n. ${String(a.numero).padStart(2, "0")}` : "n. —";
const Titolo = apertura ? "h1" : "h2";
// articoli interni (es. "/litigi-tra-alleati/") rispetto alla base del sito, esterni così come sono
const href = !a.url ? "#" : /^https?:/.test(a.url) ? a.url : url(a.url);
---
<a class:list={["art", { apertura }]} href={href} target="_blank" rel="noopener">
  <Copertina copertina={a.copertina} colore={a.colore} numero={a.numero} apertura={apertura} titolo={a.titolo} />
  <div class="txt">
    <div class="meta mono">
      <span class="n">{numero}</span><span>{data}</span><span>{a.tema}</span>
      {a.bozza && <span class="segnaposto">segnaposto</span>}
    </div>
    <Titolo>{a.titolo}</Titolo>
    <p>{a.sommario}</p>
  </div>
</a>

<style>
  /* negli articoli in griglia il testo sta sotto la copertina */
  a.art:not(.apertura) .txt { display: flex; flex-direction: column; gap: 10px; }
</style>
