---
// Copertina 16:10 con angoli squadrati. Al passaggio del mouse si ingrandisce tutto il contenuto insieme (.cop-in).
import { url } from "../config.js";
const { copertina } = Astro.props;

// moneta (n. 2): l'ENIAC (1946) e un IBM 704 (1957) tagliati in diagonale, virati in inchiostro e carta avorio,
// con sopra una passeggiata casuale rossa: 100 lanci di una moneta, testa sale e croce scende.
// I lanci vengono da un generatore con seme fisso (mulberry32), così la linea è sempre la stessa.
function seme(a) { return () => { a |= 0; a = a + 0x6D2B79F5 | 0; let t = Math.imul(a ^ a >>> 15, 1 | a); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; }; }
const r = seme(61);
let v = 0;
const PASSEGGIATA = "M" + Array.from({ length: 101 }, (_, i) => {
  if (i) v += r() < .5 ? 1 : -1;
  return `${40 + i * 15.2},${560 - v * 26}`;
}).join("L");
---
<div class="cop">
  <div class="cop-in">
    {copertina === "litigi" ? (
      <div class="c-litigi">
        <div class="ph sx" style={`background-image: url(${url("img/umberto_bossi.jpg")})`} role="img" aria-label="Umberto Bossi"></div>
        <div class="ph dx" style={`background-image: url(${url("img/silvio_berlusconi.jpg")})`} role="img" aria-label="Silvio Berlusconi"></div>
        <svg class="lampo" viewBox="0 0 60 120" aria-hidden="true"><polygon points="38,0 6,66 28,66 18,120 56,46 33,46 46,0" fill="#eb6834" stroke="#000" stroke-width="3" stroke-linejoin="round"/></svg>
      </div>
    ) : copertina === "moneta" ? (
      <svg class="c-moneta" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" role="img" aria-label="L'ENIAC e un IBM 704, attraversati da una linea rossa che sale e scende a caso">
        <defs>
          <!-- bicromia: bianco e nero, poi i neri diventano inchiostro e i bianchi carta avorio -->
          <filter id="mon-bic" color-interpolation-filters="sRGB">
            <feColorMatrix type="saturate" values="0" />
            <feComponentTransfer>
              <feFuncR type="table" tableValues="0.12 0.957" />
              <feFuncG type="table" tableValues="0.11 0.937" />
              <feFuncB type="table" tableValues="0.10 0.89" />
            </feComponentTransfer>
          </filter>
          <clipPath id="mon-sx"><polygon points="0,0 930,0 690,1000 0,1000" /></clipPath>
          <clipPath id="mon-dx"><polygon points="970,0 1600,0 1600,1000 730,1000" /></clipPath>
        </defs>
        <rect width="1600" height="1000" fill="#f4efe3" />
        <g clip-path="url(#mon-sx)"><image href={url("img/eniac_operatrici.jpg")} x="-60" y="0" width="1080" height="1000" preserveAspectRatio="xMidYMid slice" filter="url(#mon-bic)" /></g>
        <g clip-path="url(#mon-dx)"><image href={url("img/ibm_704.jpg")} x="700" y="0" width="900" height="1000" preserveAspectRatio="xMidYMid slice" filter="url(#mon-bic)" /></g>
        <!-- la linea rossa con un alone avorio, per staccarla dalle foto -->
        <path d={PASSEGGIATA} fill="none" stroke="#f4efe3" stroke-width="26" stroke-linejoin="round" stroke-linecap="round" />
        <path d={PASSEGGIATA} fill="none" stroke="#c23a2b" stroke-width="12" stroke-linejoin="round" stroke-linecap="round" />
      </svg>
    ) : (
      <div class="c-tipo" style={`background: ${copertina.colore}`}><span>{copertina.testo}</span></div>
    )}
  </div>
</div>

<style>
  .cop { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: #222; }
  .cop-in { position: absolute; inset: 0; transition: transform .5s ease; }
  :global(a.art:hover) .cop-in { transform: scale(1.03); }

  /* litigi: Bossi e Berlusconi tagliati in diagonale, con un lampo arancione in mezzo */
  .c-litigi { position: absolute; inset: 0; background: #f3efe6; }
  .ph { position: absolute; top: 0; bottom: 0; width: 58%; background-size: cover; background-position: center 22%; filter: grayscale(1) contrast(1.1); }
  .sx { left: 0; clip-path: polygon(0 0, 100% 0, 80% 100%, 0 100%); }
  .dx { right: 0; clip-path: polygon(20% 0, 100% 0, 100% 100%, 0 100%); }
  .lampo { position: absolute; left: 50%; top: 50%; width: 16%; transform: translate(-50%, -50%); }

  /* moneta: tutto è nell'SVG, che riempie la copertina tagliando i bordi se serve (slice) */
  .c-moneta { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

  /* copertina tipografica: un colore e un numero o una parola */
  .c-tipo { position: absolute; inset: 0; display: grid; place-items: center; color: #111; }
  .c-tipo span { font-weight: 700; font-size: clamp(4.5rem, 10vw, 8.5rem); line-height: 1; letter-spacing: -0.06em; }
</style>
