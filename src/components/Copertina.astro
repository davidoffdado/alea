---
// Copertina di un articolo, con una cornice colorata sopra e ai lati (alla The Pudding).
// Due formati: orizzontale 16:10 per l'ultimo articolo (apertura), verticale 4:5 per le "figurine" della griglia.
// Le immagini si generano con npm run copertine (scripts/copertine/<nome>.html -> public/img/copertine/<nome>-o.png e -v.png).
// Al passaggio del mouse si ingrandisce l'immagine, la cornice resta ferma.
//   copertina: "litigi" -> immagine; oppure { colore, testo } per le bozze (copertina tipografica)
//   colore:    colore della cornice
import { url } from "../config.js";
const { copertina, colore = "#f2f0ea", apertura = false, titolo = "" } = Astro.props;
const formato = apertura ? "o" : "v";
---
<div class:list={["cop", formato]} style={`--cornice: ${colore}`}>
  <div class="cop-in">
    {typeof copertina === "string" ? (
      <img src={url(`img/copertine/${copertina}-${formato}.png`)} alt={titolo} loading={apertura ? "eager" : "lazy"} />
    ) : (
      <div class="c-tipo" style={`background: ${copertina.colore}`}><span>{copertina.testo}</span></div>
    )}
  </div>
</div>

<style>
  .cop { position: relative; overflow: hidden; background: #222; border: 10px solid var(--cornice); border-bottom: 0; }
  .cop.o { aspect-ratio: 16 / 10; }
  .cop.v { aspect-ratio: 4 / 5; border-width: 8px; border-bottom: 0; }
  .cop-in { position: absolute; inset: 0; transition: transform .5s ease; }
  :global(a.art:hover) .cop-in { transform: scale(1.03); }
  img { display: block; width: 100%; height: 100%; object-fit: cover; }

  /* copertina tipografica: un colore e un numero o una parola */
  .c-tipo { position: absolute; inset: 0; display: grid; place-items: center; color: #111; }
  .c-tipo span { font-weight: 700; font-size: clamp(4.5rem, 10vw, 8.5rem); line-height: 1; letter-spacing: -0.06em; }
</style>
